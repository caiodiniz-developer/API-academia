generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id String @id @default(uuid())
  name String
  email String @unique

  @@map("users")
}

model CheckIn {
  id String @id @default(uuid())
}

model Gym {
  id String @id @default(uuid())
  title String
  description String?
  phone String?
  latitude Decimal
  longitude Decimal
}